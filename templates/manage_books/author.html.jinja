{% extends "base.html.jinja" %}

{% block title %}{{ author }} — Biblioteka Domowa{% endblock %}

{% block topbar %}
<div class="topbar">
  <div>
    <a href="{% url 'index' %}" class="muted" style="font-size:0.8rem;text-decoration:none">← Katalog</a>
    <h1 class="serif" style="margin-top:0.15rem">{% if author.title %}{{ author.get_title_display }} {% endif %}{{ author.first_name }} {{ author.last_name }}</h1>
    {% if author.alias %}<p class="muted" style="margin:0.15rem 0 0;font-size:0.875rem">„{{ author.alias }}"</p>{% endif %}
  </div>
  {% if user.is_authenticated %}<a href="{% url 'author_edit' pk=author.id %}" class="btn btn-sm">Edytuj</a>{% endif %}
</div>
{% endblock %}

{% block content %}
<div style="display:grid;grid-template-columns:12rem 1fr;border:1px solid var(--line)">
  <div style="padding:1rem;background:var(--paper-2);border-right:1px solid var(--line)">
    <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:0.25rem">Narodowość</div>
    <div>{{ author.nationality }}</div>
    <div style="margin-top:1rem;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:0.25rem">Książek</div>
    <div style="font-size:1.5rem;font-family:'Libre Baskerville',serif">{{ books|length }}</div>
  </div>
  <div>
    <div class="panel-head">Pozycje w bibliotece</div>
  {% include "manage_books/_book_table.html.jinja" with books=books compact=False only %}
  </div>
</div>
{% endblock %}
