{% extends "base.html.jinja" %}

{% block title %}Logowanie — Biblioteka Domowa{% endblock %}

{% block shell %}
<div class="auth-screen">
  <div class="auth-left">
    <h1 class="serif">Biblioteka Domowa</h1>
    <p>Twój prywatny katalog książek. Przeglądaj kolekcję, dodawaj notatki i zarządzaj słownikami autorów, wydawców i serii.</p>
  </div>
  <div class="auth-right">
    <div class="auth-form">
      <h2 class="serif" style="margin:0 0 0.25rem;font-size:1.5rem">Logowanie</h2>
      <p class="muted" style="margin:0 0 1.5rem;font-size:0.875rem">Wpisz dane konta</p>
      <form method="post">
        {% csrf_token %}
        {% for field in form %}
        <div class="form-field" style="margin-bottom:1rem">
          <label>{{ field.label }}</label>
          {{ field }}
          {% if field.errors %}<p style="color:#991b1b;font-size:0.8rem;margin:0.25rem 0 0">{{ field.errors.0 }}</p>{% endif %}
        </div>
        {% endfor %}
        <button type="submit" class="btn btn-accent" style="width:100%;padding:0.6rem">Zaloguj</button>
      </form>
      <p class="muted" style="margin-top:1.25rem;font-size:0.875rem;text-align:center">
        Brak konta? <a href="{% url 'register' %}" class="link">Zarejestruj się</a>
      </p>
    </div>
  </div>
</div>
{% endblock %}
