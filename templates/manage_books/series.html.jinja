{% extends "base.html.jinja" %}

{% block title %}{{ series.name }} — Biblioteka Domowa{% endblock %}

{% block topbar %}
<div class="topbar">
  <div>
    <a href="{% url 'index' %}" class="muted" style="font-size:0.8rem;text-decoration:none">← Katalog</a>
    <h1 class="serif" style="margin-top:0.15rem">{{ series.name }}</h1>
    {% if series.description %}<p class="muted" style="margin:0.15rem 0 0;font-size:0.875rem;max-width:40rem">{{ series.description }}</p>{% endif %}
  </div>
  {% if user.is_authenticated %}<a href="{% url 'series_edit' pk=series.id %}" class="btn btn-sm">Edytuj</a>{% endif %}
</div>
{% endblock %}

{% block content %}
<div class="panel">
  <div class="panel-head">
    <span>Kolejność wydania</span>
    <span class="muted">{{ books_count }} książek w bibliotece</span>
  </div>
  {% if books %}
  <table class="data-table">
    <thead><tr><th style="width:2.5rem">#</th><th>Tytuł</th><th>Rok</th></tr></thead>
    <tbody>
      {% for book in books %}
      <tr>
        <td class="num">{{ forloop.counter }}</td>
        <td><a href="{% url 'book' book_id=book.id %}" class="link">{{ book.title }}</a></td>
        <td class="num">{{ book.publication_date.year }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="muted" style="padding:1.5rem;text-align:center">Brak książek</p>
  {% endif %}
</div>
{% endblock %}
