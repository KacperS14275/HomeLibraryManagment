{% extends "base.html.jinja" %}

{% block title %}{{ book.title }} — Biblioteka Domowa{% endblock %}

{% block topbar %}
<div class="topbar">
  <div>
    <a href="{% url 'index' %}" class="muted" style="font-size:0.8rem;text-decoration:none">← Katalog</a>
    <h1 class="serif" style="margin-top:0.15rem">{{ book.title }}</h1>
  </div>
  {% if user.is_authenticated %}
  <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
    <form method="post" action="{% url 'book_toggle_read' book_id=book.id %}">{% csrf_token %}
      <button type="submit" class="btn btn-sm">{% if book.is_read %}Nieprzeczytana{% else %}Przeczytana{% endif %}</button>
    </form>
    <form method="post" action="{% url 'book_toggle_favorite' book_id=book.id %}">{% csrf_token %}
      <button type="submit" class="btn btn-sm">{% if book.is_favorite %}Usuń z ulub.{% else %}Ulubiona{% endif %}</button>
    </form>
    <a href="{% url 'book_edit' book_id=book.id %}" class="btn btn-sm">Edytuj</a>
    <a href="{% url 'book_delete' book_id=book.id %}" class="btn btn-danger btn-sm">Usuń</a>
  </div>
  {% else %}
  <a href="{% url 'login' %}?next={% url 'book' book_id=book.id %}" class="btn btn-accent">Zaloguj się</a>
  {% endif %}
</div>
{% endblock %}

{% block content %}
<div style="display:grid; grid-template-columns: 1fr minmax(18rem, 28rem); gap: 0; border: 1px solid var(--line); min-height: 60vh;">
  <div style="border-right:1px solid var(--line)">
    <div style="padding:0.75rem 1rem;background:var(--paper-2);border-bottom:1px solid var(--line);font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">
      Karta książki
      {% if book.is_favorite %} · <span style="color:#d97706">ulubiona</span>{% endif %}
      {% if book.is_read %} · <span style="color:#059669">przeczytana</span>{% endif %}
    </div>
    <table class="meta-table">
      <tr><th>ISBN</th><td class="num">{{ book.isbn }}</td></tr>
      <tr><th>Data publikacji</th><td>{{ book.publication_date }}</td></tr>
      <tr><th>Strony</th><td>{{ book.pages }}</td></tr>
      <tr><th>Okładka</th><td>{{ book.get_cover_display }}</td></tr>
      <tr><th>Język</th><td>{{ book.get_language_display }}</td></tr>
      <tr><th>Autorzy</th><td>
        {% for author in book.authors.all %}<a href="{% url 'author' author_id=author.id %}" class="link">{{ author }}</a>{% if not forloop.last %}, {% endif %}{% empty %}—{% endfor %}
      </td></tr>
      <tr><th>Wydawca</th><td><a href="{% url 'publisher' publisher_id=book.publisher.id %}" class="link">{{ book.publisher.name }}</a></td></tr>
      {% if book.series %}<tr><th>Seria</th><td><a href="{% url 'series' series_id=book.series.id %}" class="link">{{ book.series.name }}</a></td></tr>{% endif %}
      {% if book.category %}<tr><th>Dział</th><td>{{ book.category.name }}</td></tr>{% endif %}
      <tr><th>Gatunki</th><td>{% for g in book.genres.all %}{{ g.name }}{% if not forloop.last %}, {% endif %}{% empty %}—{% endfor %}</td></tr>
      <tr><th>Tematy</th><td>{% for t in book.topics.all %}{{ t.name }}{% if not forloop.last %}, {% endif %}{% empty %}—{% endfor %}</td></tr>
    </table>
  </div>

  <div>
    <div style="padding:0.75rem 1rem;background:var(--paper-2);border-bottom:1px solid var(--line);font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em">
      Notatki ({{ book.notes.count }})
    </div>
    <div style="padding:1rem">
      {% if book.notes.all %}
      {% for note in book.notes.all %}
      <div style="border-left:3px solid var(--accent);padding:0.5rem 0 0.5rem 0.75rem;margin-bottom:1rem">
        <p style="margin:0 0 0.35rem">{{ note.content }}</p>
        <p class="muted" style="margin:0;font-size:0.75rem">{{ note.created_at|date:"d.m.Y H:i" }}</p>
      </div>
      {% endfor %}
      {% else %}
      <p class="muted" style="font-size:0.875rem;margin:0 0 1rem">Brak notatek.</p>
      {% endif %}

      {% if user.is_authenticated %}
      <form method="post" action="{% url 'book_add_note' book_id=book.id %}">
        {% csrf_token %}
        <label style="font-size:0.75rem;font-weight:600;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:0.35rem">Nowa notatka</label>
        {{ note_form.content }}
        <button type="submit" class="btn btn-accent" style="margin-top:0.5rem">Zapisz</button>
      </form>
      {% endif %}
    </div>
  </div>
</div>

<style>@media(max-width:800px){.content>div{grid-template-columns:1fr!important}}</style>
{% endblock %}
