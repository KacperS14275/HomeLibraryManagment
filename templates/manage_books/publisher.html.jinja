{% extends "base.html.jinja" %}

{% block title %}{{ publisher.name }} — Biblioteka Domowa{% endblock %}

{% block topbar %}
<div class="topbar">
  <div>
    <a href="{% url 'index' %}" class="muted" style="font-size:0.8rem;text-decoration:none">← Katalog</a>
    <h1 class="serif" style="margin-top:0.15rem">{{ publisher.name }}</h1>
  </div>
  {% if user.is_authenticated %}<a href="{% url 'publisher_edit' pk=publisher.id %}" class="btn btn-sm">Edytuj</a>{% endif %}
</div>
{% endblock %}

{% block content %}
<div style="display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);min-height:50vh">
  <div style="border-right:1px solid var(--line)">
    <div class="panel-head">Dane wydawcy</div>
    <table class="meta-table">
      <tr><th>Kraj</th><td>{{ publisher.get_country_display }}</td></tr>
      <tr><th>Rok założenia</th><td>{{ publisher.founded_year }}</td></tr>
      {% if publisher.website %}<tr><th>WWW</th><td><a href="{{ publisher.website }}" target="_blank" class="link">{{ publisher.website }}</a></td></tr>{% endif %}
      {% if publisher.email %}<tr><th>E-mail</th><td><a href="mailto:{{ publisher.email }}" class="link">{{ publisher.email }}</a></td></tr>{% endif %}
    </table>
  </div>
  <div>
    <div class="panel-head">Książki <span class="muted">{{ books|length }}</span></div>
    {% include "manage_books/_book_table.html.jinja" with books=books compact=True only %}
  </div>
</div>
{% endblock %}
